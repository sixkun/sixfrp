# syntax=docker/dockerfile:1
# frppc 客户端镜像（在原生 BUILDPLATFORM 上交叉编译，避免 QEMU 模拟）
FROM --platform=$BUILDPLATFORM golang:1.26.1-alpine AS builder

ENV GO111MODULE=on \
    CGO_ENABLED=0 \
    GOEXPERIMENT=jsonv2 \
    GOPRIVATE=cnb.cool/gradii/goravel,cnb.cool/gradii/frp

ARG VERSION=dev
# 由 buildx 自动注入：目标平台信息
ARG TARGETOS
ARG TARGETARCH
ARG TARGETVARIANT

# git：go 拉取 cnb.cool 私有模块需通过 git 克隆
RUN apk add --no-cache git

WORKDIR /build
COPY . .
# GOARM 取变体号（v6/v7 -> 6/7），对 amd64/arm64 为空且被忽略
# netrc 以 secret 挂载，仅构建期可见，不写入镜像层，用于拉取私有 Go 模块
#
# -X 的包路径必须是本次构建图里真实存在的包。此处曾写作 haokun-panel/haokun/version，
# 而本模块是 cnb.cool/sixkun/sixfrp/v2，该包并不在 ./cmd/frppc 的依赖图中，
# 于是三个 -X 被静默忽略，所有 Docker 构建出的 frppc 版本号都是空的。
RUN --mount=type=secret,id=netrc,target=/root/.netrc \
    GOOS=${TARGETOS} GOARCH=${TARGETARCH} GOARM=${TARGETVARIANT#v} \
    go build -trimpath -buildvcs=false \
      --ldflags "-s -w -X cnb.cool/sixkun/sixfrp/v2/haokun/version.Version=${VERSION} -X cnb.cool/sixkun/sixfrp/v2/haokun/version.ReleaseArch=${TARGETARCH} -X cnb.cool/sixkun/sixfrp/v2/haokun/version.DockerImage=true" \
      -o frppc ./cmd/frppc

FROM alpine:latest

# GHCR 依赖此 label 把镜像关联到 GitHub 仓库（namespace 必须与 ghcr.io/sixkun/sixfrp 一致）。
# label 不会跨 stage 继承，必须写在最终 stage；skopeo copy 复制原 manifest，同步到 GHCR 后依然保留。
LABEL org.opencontainers.image.source="https://github.com/sixkun/sixfrp"

RUN apk add --no-cache ca-certificates

WORKDIR /app
COPY --from=builder /build/frppc /app/frppc

ENTRYPOINT ["/app/frppc"]
