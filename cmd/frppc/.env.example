# cmd/frppc/.env.example
# Per-binary env file for the frppc (FRP Panel Client) binary.
# Populate values here, copy to cmd/frppc/.env at deploy time, or rely on
# the project-root .env which is also consulted by Goravel.

### App scope
# These mirror APP_* but are scoped to the frppc binary so it can run with
# different debug/locale settings than the master/server.
FRPPC_APP_NAME=Goravel
FRPPC_APP_ENV=production
FRPPC_APP_DEBUG=false
FRPPC_APP_KEY=

### Logging
# Goravel logging.* config keys; same names as the rest of the project.
LOG_CHANNEL=stack
LOG_LEVEL=debug

### Core client identity / master endpoint
# Whether the client runtime should connect at startup. Set to false to keep
# the binary running but quiescent (useful for local dev / Goravel artisan).
FRPPC_ENABLED=true

# Identity assigned by the master. Pair (FRPPC_ID, FRPPC_SECRET) authenticates
# every RPC call against the master.
FRPPC_ID=
FRPPC_SECRET=

# Master gRPC URL. Schemes:
#   grpc://host:port            — plain gRPC (default)
#   ws://host:port/grpc-ws      — gRPC tunneled over WebSocket
#   wss://host:port/grpc-ws     — TLS-wrapped WebSocket
#   bare host:port              — coerced to grpc://; if port is 3000,
#                                 inferred as ws://host:3000/grpc-ws
FRPPC_RPC_URL=grpc://127.0.0.1:9001

# Periodic config-pull interval in seconds. The runtime additionally pulls
# once at startup, so this is the cadence for *re-sync* (proxy add/remove
# from the master).
FRPPC_SYNC_INTERVAL_SECONDS=30

### Remote shell (PTY) feature gates
# Set to false to refuse all PTY connect requests pushed by the master.
# When false, EVENT_START_PTY_CONNECT returns an error to the master.
FRPPC_FEATURES_ENABLE_REMOTE_SHELL=true

# When set, every PTY connect request is gated by TOTP:
#   1. First connect → returns PTY_CONNECT_STATUS_TOTP_BIND_REQUIRED with
#      an otpauth:// URI for the user to scan.
#   2. After bind   → returns PTY_CONNECT_STATUS_TOTP_VERIFY_REQUIRED on
#      every subsequent connect, requiring a fresh code via
#      EVENT_PTY_TOTP_VERIFY.
# Leave empty to disable TOTP gating (PTY opens immediately when above is true).
FRPPC_FEATURES_TOTP_SECRET=
